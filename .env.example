# Port the API listens on
PORT=3000

# MongoDB connection string
# (docker-compose replaces this with the address of its own mongo container)
MONGODB_URI=mongodb://localhost:27017/shop_api

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Front-end origins allowed to call the API, comma-separated.
# Leave empty if only server-side clients or Postman will call it.
CORS_ORIGIN=http://localhost:8080

# Used by `npm run seed` to create the first admin account
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
